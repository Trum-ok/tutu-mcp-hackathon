# Скопируйте в .env и заполните:  cp .env.example .env
# .env в .gitignore — реальные ключи в репозиторий не попадут.

# --- OpenAI: нужен только для эвалов (make evals) ---
# Агент, который прогоняет сценарии, и точный замер токенов поверхности.
# Прокси (make run-mock / run-live) и тесты работают без ключа.
OPENAI_API_KEY=

# Модель по умолчанию для эвалов. Посмотреть, что доступно вашему ключу:
#     uv run python tutu.py evals --list-models
OPENAI_MODEL=gpt-5

# Усилие рассуждения по умолчанию. Шкала своя у каждой модели: gpt-5 знает
# minimal и не знает xhigh/max, gpt-5.6 — наоборот. Недопустимую ступень
# отвергает сам API, и его ошибка перечисляет доступные для вашей модели.
# Пустая переменная — поле reasoning не отправляется вовсе, усилие выбирает
# сама модель; `none` — это уже явное указание не рассуждать. Флаг --effort
# перебивает эту переменную.
# OPENAI_EFFORT=

# Задайте, если используете OpenAI-совместимый шлюз, а не api.openai.com
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Прокси перед mcp.tutu.ru ---
# mock (по умолчанию) — отвечает записанными фикстурами, сеть не трогает.
# live — проксирует настоящий mcp.tutu.ru, попадает под общий рейт-лимит хакатона.
TUTU_PROXY_MODE=mock
TUTU_UPSTREAM_URL=https://mcp.tutu.ru/mcp
TUTU_PROXY_HOST=127.0.0.1
TUTU_PROXY_PORT=8800

# Таймаут одного запроса к живому mcp.tutu.ru, в секундах.
# TUTU_UPSTREAM_TIMEOUT_S=20

# Каталог с фикстурами (по умолчанию ./fixtures)
# TUTU_FIXTURES_DIR=
